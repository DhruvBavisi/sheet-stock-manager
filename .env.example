# Dual Email Google Sheets Connection Configuration
# Account 1 (Email 1) Connection
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID_1/exec
VITE_GOOGLE_SHEET_ID=YOUR_SPREADSHEET_ID_1

# Account 2 (Email 2) Connection (Simultaneous Sync)
VITE_APPS_SCRIPT_URL_2=https://script.google.com/macros/s/YOUR_SCRIPT_ID_2/exec
VITE_GOOGLE_SHEET_ID_2=YOUR_SPREADSHEET_ID_2

# Default Sheet Name (Tab is dynamically created: PUL-32, PUL-25, or Sieving)
VITE_GOOGLE_SHEET_NAME=PUL-32
